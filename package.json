{
  "name": "@intuitui-labs/editorial",
  "version": "0.1.0",
  "description": "Provider-neutral editorial publishing contracts, page metadata schemas, and distribution ledger",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --build --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
